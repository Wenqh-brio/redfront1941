  "endless_mode": {
    "id": "endless_waves",
    "name_zh": "无限模式：永不停歇的战线",
    "name_en": "Endless: The Line Never Rests",
    "description": "在随机生成的战区地形上抵御无穷波次敌军。每 5 波为一个「战役阶段」，从 1941 年的德军步兵推进演变为 1945 年的虎王/豹式与国民突击队混合攻势。",
    "rules": [
      "波次之间 45 秒整备：可补给食物/水/弹药、更换武器、构筑掩体。",
      "每波敌人组成随波次与所选年代加权（1941/1943/1945 三套表）。",
      "玩家死亡即结束；每 5 波获得一次「复活卡」与 1 次免费支援。",
      "天气与昼夜每 3 波随机变化，影响视野、炮击精度与空中支援可用性。",
      "难度曲线：波次 n 的敌人数量 = 4 + floor(n*1.6)，精英单位从第 6 波开始出现。"
    ],
